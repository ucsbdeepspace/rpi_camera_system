__pycache__/
*.pyc

# kernel module build byproducts (kernel_patch/*/ov9282.ko is the tracked build output;
# these are intermediate files regenerated by `make` against the matching headers)
kernel_patch/*/*.o
kernel_patch/*/*.mod
kernel_patch/*/*.mod.c
kernel_patch/*/Module.symvers
kernel_patch/*/modules.order
kernel_patch/*/.*.cmd
kernel_patch/*/.tmp_versions/
kernel_patch/*/.cache.mk
